# Telegram API credentials from my.telegram.org
API_ID=
API_HASH=

# Telegram Bot API / owner-only control surface
BOT_TOKEN=
OWNER_ID=

# Runtime v2 / PostgreSQL
DATABASE_URL=
V2_ACCOUNT_ID=
V2_SESSION_PATH=/app/data/v2.session
V2_MEDIA_ROOT=/app/data/media
V2_WORKER_ID=publisher-v2-1
V2_POLL_INTERVAL_SECONDS=1
V2_QUEUE_BATCH_SIZE=10
V2_RETRY_DELAY_SECONDS=60
V2_MAX_RETRY_ATTEMPTS=8
V2_RECONNECT_DELAY_SECONDS=5

# Web dashboard / API
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=
WEB_SESSION_SECRET=
WEB_ADMIN_TOKEN=
WEB_SESSION_TTL_SECONDS=43200
WEB_COOKIE_SECURE=true
WEB_ACCESS_LOG=false

# PostgreSQL Compose defaults
POSTGRES_DB=telegram_relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
WEB_PORT=8080
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Telegram publishing
LOG_LEVEL=INFO
FLOOD_WAIT_RETRIES=3
SEND_INTERVAL_SECONDS=1.1

# Legacy v1 values are kept only for migration compatibility.
SESSION_PATH=data/telegram_user.session
DATABASE_PATH=data/relay.sqlite3
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=
ALBUM_WINDOW_SECONDS=0.8
RECONNECT_DELAYS=5,15,30,60
EVENT_LOG_KEEP=1000
