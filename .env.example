# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# BotFather control bot
BOT_TOKEN=
OWNER_ID=

# Shared PostgreSQL connection
# DATABASE_URL=postgresql+asyncpg://relay:change-me-in-env@localhost:5432/telegram_relay
# POSTGRES_DB=telegram_relay
# POSTGRES_USER=relay
# POSTGRES_PASSWORD=change-me-in-env
# POSTGRES_PORT=5432
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=1800
# DATABASE_ECHO=false

# V3 foundation
APP_ENV=development
LOG_LEVEL=INFO

# V3 Telegram ingestion — disabled until Phase 3 is intentionally run.
V3_TELEGRAM_ENABLED=false
# V3_ACCOUNT_ID=
# V3_TELEGRAM_ACCOUNT_ID=
V3_SESSION_PATH=data/v3.session
V3_ALBUM_WINDOW_SECONDS=0.8
V3_RECONNECT_DELAYS=5,15,30,60

# Legacy/V2 compatibility during the controlled rebuild.
SESSION_PATH=data/telegram_user.session
DATABASE_PATH=data/relay.sqlite3
# V2_ACCOUNT_ID=
# V2_SESSION_PATH=data/v2.session
# V2_WORKER_ID=publisher-v2-1
# V2_POLL_INTERVAL_SECONDS=1
# V2_QUEUE_BATCH_SIZE=10
# V2_RETRY_DELAY_SECONDS=60

# Legacy branding/filter compatibility.
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=
ALBUM_WINDOW_SECONDS=0.8
FLOOD_WAIT_RETRIES=3
SEND_INTERVAL_SECONDS=1.1
RECONNECT_DELAYS=5,15,30,60
EVENT_LOG_KEEP=1000
