# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# BotFather control bot
BOT_TOKEN=
OWNER_ID=

# User session storage; never commit the resulting file
SESSION_PATH=data/telegram_user.session

# SQLite
DATABASE_PATH=data/relay.sqlite3

# PostgreSQL v2 data layer (required when the v2 application is enabled)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telegram_relay
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=1800
# DATABASE_ECHO=false

# Integrated Runtime v2
# V2_ACCOUNT_ID=uuid-of-the-imported-account
# V2_SESSION_PATH=data/v2.session
# V2_WORKER_ID=publisher-v2-1
# V2_POLL_INTERVAL_SECONDS=1
# V2_QUEUE_BATCH_SIZE=10
# V2_RETRY_DELAY_SECONDS=60

# Branding is fixed in backend/app/config.py:
# #أخبار_اليمن_الان تابع أحدث الاخبار
# https://t.me/yemen_no

# Optional filter defaults, comma-separated
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=

# Runtime
LOG_LEVEL=INFO
ALBUM_WINDOW_SECONDS=0.8
FLOOD_WAIT_RETRIES=3
SEND_INTERVAL_SECONDS=1.1
RECONNECT_DELAYS=5,15,30,60
EVENT_LOG_KEEP=1000
