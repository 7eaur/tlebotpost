# إعدادات حساب Telegram API
# احصل عليها من: https://my.telegram.org/auth
API_ID=12345678
API_HASH=your_api_hash_here

# توكن بوت التحكم من @BotFather
BOT_TOKEN=your_bot_token_here

# معرف المالك (الشخص الوحيد المسموح له بالتحكم)
OWNER_ID=123456789

# مفتاح تشفير الجلسة (32 بايت base64) - استخدم أحرفاً عشوائية قوية
# يمكنك إنشاؤه عبر: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=your_32_char_encryption_key_here

# إعدادات اختيارية
MIN_DELAY=300
MAX_DELAY=900
SLEEP_START=23
SLEEP_END=6
DEFAULT_POSTS_PER_DAY=2

# مسارات التشغيل
DATABASE_PATH=data/telegram_smart_poster.db
SESSION_PATH=data/session.enc

# إعدادات الواجهة (Vite)
VITE_APP_ID=your_app_id_here
VITE_SENTRY_DSN=your_sentry_dsn_here
